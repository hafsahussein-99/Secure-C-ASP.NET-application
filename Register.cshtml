@model SecureWebApp.Models.UserModel

@{
    ViewData["Title"] = "Secure Registration Portal";
}

<div class="container" style="max-width: 500px; margin-top: 50px;">
    <h2>Secure User Registration</h2>
    <hr />

    @if (ViewBag.SuccessMessage != null)
    {
        <div class="alert alert-success">@ViewBag.SuccessMessage</div>
    }
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
    }

    <form asp-action="Register" method="post">
        <!-- Renders hidden verification tokens to handle anti-forgery processes -->
        @Html.AntiForgeryToken()

        <div class="form-group mb-3">
            <label asp-for="Username" class="control-label"></label>
            <input asp-for="Username" class="form-control" placeholder="Enter alphanumeric string username" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Email" class="control-label"></label>
            <input asp-for="Email" class="form-control" placeholder="example@domain.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group mb-4">
            <label asp-for="Password" class="control-label"></label>
            <input asp-for="Password" type="password" class="form-control" placeholder="Minimum 8 complex characters" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group">
            <input type="submit" value="Register Account" class="btn btn-primary w-100" />
        </div>
    </form>
</div>
